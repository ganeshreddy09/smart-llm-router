OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=postgresql://router:router@localhost:5432/smart_llm_router
CACHE_SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMPLE_MODEL=gpt-4o-mini
COMPLEX_MODEL=gpt-4o
LOG_LEVEL=INFO

# Cache entries older than this are ignored on lookup and removed by
# scripts/evict_cache.py.
CACHE_TTL_DAYS=30

# If set, POST /query requires header "X-API-Key: <this value>". Leave
# empty for local/demo use. See README "Auth" section.
API_KEY=

# Set true to simulate LLM completions locally — no OPENAI_API_KEY needed,
# no API spend. Embeddings/caching/routing/cost-math still run for real.
# See README "Mock mode". Leave OPENAI_API_KEY as the placeholder above
# when this is true — it's simply never used.
MOCK_MODE=true
